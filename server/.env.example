PORT=5000

MONGODB_URI=

NODE_ENV=development

CLIENT_URL=http://localhost:5173

SCHEDULER_SECRET=your_super_secret_key

# Scheduler Configuration
ORDER_SCHEDULER_CRON=*/5 * * * *
CLEANUP_SCHEDULER_CRON=0 2 * * *
LOG_RETENTION_DAYS=30

# Enable/Disable Schedulers
ENABLE_ORDER_SCHEDULER=true
ENABLE_CLEANUP_SCHEDULER=true